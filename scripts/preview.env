# Deliberately inert values for local production-build smoke tests.
# Passing this file explicitly prevents Wrangler from loading real provider
# credentials from the developer's normal environment files.
APP_ENV=preview
APP_URL=http://127.0.0.1:4174
SUPABASE_URL=https://preview.invalid
SUPABASE_PROJECT_ID=preview
SUPABASE_PUBLISHABLE_KEY=preview-only
SUPABASE_SERVICE_ROLE_KEY=preview-only
MONITORING_SECRET=preview-only
CRON_REMINDER_SECRET=preview-only
CALENDAR_SYNC_SECRET=preview-only
