{
  "expo": {
    "name": "Bookzenvo",
    "slug": "bookzenvo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "bookzenvo",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.finkodigital.bookzenvo",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Use your camera to photograph stock or add business, staff and customer photos you choose to upload.",
        "NSPhotoLibraryUsageDescription": "Choose photos to upload to your Bookzenvo business, staff, customers or booking page."
      }
    },
    "android": {
      "package": "com.finkodigital.bookzenvo",
      "adaptiveIcon": {
        "backgroundColor": "#FAFAF8",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FAFAF8",
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain"
        }
      ],
      "expo-sharing",
      "expo-status-bar"
    ],
    "extra": {
      "eas": {
        "projectId": "29705a11-9f04-4a4c-90b2-991f3a39077a"
      }
    },
    "owner": "jakobfinklers-team"
  }
}
