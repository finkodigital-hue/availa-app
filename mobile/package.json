{
  "name": "mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@expo-google-fonts/cormorant-garamond": "^0.4.1",
    "@expo-google-fonts/dm-sans": "^0.4.2",
    "@expo/vector-icons": "^15.0.3",
    "@supabase/supabase-js": "^2.110.8",
    "expo": "~58.0.26",
    "expo-constants": "~58.0.16",
    "expo-crypto": "~58.0.8",
    "expo-file-system": "~58.0.14",
    "expo-font": "~58.0.12",
    "expo-linking": "~58.0.17",
    "expo-network": "~58.0.5",
    "expo-secure-store": "~58.0.3",
    "expo-sharing": "~58.0.23",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-web-browser": "~58.1.0",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-webview": "14.0.1"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "check": "npx expo-doctor && tsc --noEmit && npm test",
    "test": "node tests/release-readiness.cjs && node tests/google-sign-in.cjs && node tests/account-data-entry.cjs && node tests/native-session-commit.cjs && node ../scripts/test-mobile-session.mjs && node ../scripts/test-mobile-secure-store.mjs && node ../scripts/test-mobile-exports.mjs && node ../scripts/test-mobile-shell.mjs && node ../scripts/test-mobile-fingerprint.mjs",
    "build:preview:ios": "npx eas-cli build --profile preview --platform ios",
    "build:preview:android": "npx eas-cli build --profile preview --platform android",
    "build:production": "npx eas-cli build --profile production --platform all"
  },
  "private": true,
  "overrides": {
    "expo": "$expo",
    "@expo/fingerprint": {
      "minimatch": "11.0.8"
    }
  }
}
